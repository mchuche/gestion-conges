# Configuration Docker Compose — stack complète (profil « docker »).
#
# Usage recommandé sur un serveur / VM :
#   cp .env.docker.example .env.docker
#   nano .env.docker   # renseigner l’IP ou le nom d’hôte ACCESSIBLE depuis ton navigateur
#   docker compose --env-file .env.docker --profile docker up -d --build
#
# Alternative : ajouter les mêmes variables (DOCKER_PUBLIC_API_URL, DOCKER_CORS_ORIGINS)
# dans ton fichier .env à la racine — Docker Compose les lit automatiquement.
#
# Règle : l’URL API doit être celle que le NAVIGRATEUR utilise (pas « localhost »
# depuis ton PC si l’API tourne sur une autre machine).

# URL de base de l’API vue depuis le navigateur (build du front Vite + appels XHR)
DOCKER_PUBLIC_API_URL=http://localhost:3000

# Origines CORS autorisées pour l’API Nest — liste séparée par des virgules, sans espaces.
# Inclure chaque origine du front : schéma + hôte + port (ex. http://192.168.1.47:8080).
DOCKER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
