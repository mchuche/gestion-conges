# Copier vers .env et ajuster si besoin

# Base PostgreSQL (docker-compose à la racine du monorepo)
DATABASE_URL="postgresql://gestion:gestion_dev@localhost:5433/gestion_conges?schema=public"

PORT=3000

# Origines autorisées pour le front (virgules). En dev, 127.0.0.1 est aussi accepté automatiquement.
# Exemple : http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173

# JWT access (obligatoire) — chaîne longue et aléatoire en production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
# Durée de vie du refresh token opaque stocké en base (RefreshToken.expiresAt)
JWT_REFRESH_EXPIRES_DAYS=7

# --- Premier super-admin (optionnel, seed / npm run bootstrap-admin) ---
# Si les deux sont définis et qu’aucun super_admin n’existe encore : création du user + AppAdmin.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=motDePasseSûr
# BOOTSTRAP_ADMIN_NAME=Administrateur

# Promouvoir un utilisateur déjà en base (User existe) — ignoré si absent
# PROMOTE_SUPER_ADMIN_EMAIL=collegue@example.com
